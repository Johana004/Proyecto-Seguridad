alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB TiendaCR - Posible inyeccion SQL (UNION SELECT) en URI"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000001; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB TiendaCR - Posible fuerza bruta contra login DVWA"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login.php"; threshold:type threshold, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)
